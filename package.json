{
  "name": "localdrop",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server/index.ts",

    "build:public": "bun build ./src/client/main.ts --outfile ./public/main.js --format esm",
    "build:client": "bun build ./src/client/main.ts --outfile ./dist/public/main.js --format esm",
    "build:compile": "bun build --compile ./src/server/index.ts --outfile ./dist/localdrop",

    "build": "bun run build:public && bun run build:compile",
    "build:all": "bun run build:client && bun run build:compile",

    "start": "./dist/localdrop",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {},
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "hono": "^4.12.8",
    "open": "^11.0.0",
    "qrcode": "^1.5.4"
  }
}
